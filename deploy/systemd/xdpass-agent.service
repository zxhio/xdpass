[Unit]
Description=xdpass-agent - XDP-based traffic filtering and response service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/xdpass-agent -config /etc/xdpass/agent/config.yaml
Restart=on-failure
RestartSec=5
LogsDirectory=xdpass
LimitNOFILE=65536
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_BPF CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_BPF CAP_SYS_ADMIN
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
